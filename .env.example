# Local development configuration.
#
# Copy to `.env` and fill in. `.env` is git-ignored, but it IS bundled as
# a Flutter asset, so treat everything here as public — nothing in this
# file is secret, and nothing secret belongs in it.
#
# Release builds should not rely on this file at all. Pass the same keys
# with --dart-define so they are compiled in rather than shipped as a
# readable asset:
#
#   flutter build apk --release \
#     --dart-define=SUPABASE_URL=... \
#     --dart-define=SUPABASE_ANON_KEY=... \
#     --dart-define=GOOGLE_BOOKS_API_KEY=... \
#     --dart-define=REVENUECAT_API_KEY=...
#
# The model provider key is deliberately absent: it is a Supabase
# project secret held by the `parse-command` edge function, never
# shipped to the device. Set it with:
#
#   supabase secrets set GROQ_API_KEY=...

# Required.
SUPABASE_URL=https://your-project.supabase.co

# Supabase's publishable ("anon") key. Public by design — row level
# security is what actually gates the data.
SUPABASE_ANON_KEY=your-supabase-anon-key

# RevenueCat's *public* SDK key, not a secret API key.
REVENUECAT_API_KEY=your-revenuecat-public-sdk-key

# Optional — without it, book search falls back to Google Books'
# lower-quota anonymous access rather than failing.
GOOGLE_BOOKS_API_KEY=your-google-books-api-key
