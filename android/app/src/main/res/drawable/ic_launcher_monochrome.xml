<?xml version="1.0" encoding="utf-8"?>
<!-- The monochrome layer every adaptive-icon XML references. Android
     13+'s "themed icons" (Material You) setting auto-generates a
     monochrome icon from whatever an app supplies, and for a flattened,
     textured background layer like ours — no separate foreground shape
     to isolate — that auto-extraction produces a muddy, unrecognizable
     blob rather than a cactus. Supplying this vector outline directly
     (the same cactus geometry every icon variant draws) is what the
     themed-icon feature actually shows instead. Shared by every variant
     since the glyph itself never changes, only the colors behind it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="62"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M256,128 L256,424 M256,312 L172,312 L172,188 M256,258 L340,258 L340,148" />
</vector>
